APP_NAME=Pawesome
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-railway-backend.up.railway.app
FRONTEND_URL=https://your-vercel-frontend.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=your-vercel-frontend.vercel.app,localhost:3000,localhost:3001,localhost:3002,localhost:3003
CORS_ALLOWED_ORIGINS=https://your-vercel-frontend.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
CORS_SUPPORTS_CREDENTIALS=true

# Trusted reverse proxies for X-Forwarded-* headers. The app is always deployed
# behind a TLS-terminating edge (Railway/Vercel/Cloudflare), so the default "*"
# keeps generated URLs https. Restrict to edge CIDRs only if you control them.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
PRIVATE_STORAGE_DRIVER=local
PUBLIC_STORAGE_DRIVER=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Email delivery ---
# Local dev without a real provider: MAIL_MAILER=log writes emails (incl. the
# verification/reset links) to storage/logs/laravel.log — nothing is sent.
# Tests use MAIL_MAILER=array (see .env.testing / phpunit.xml).
#
# Production/demo — Brevo HTTPS API (required on Railway Free/Trial/Hobby,
# which block outbound SMTP ports 25/465/587/2525):
#   MAIL_MAILER=brevo uses the symfony/brevo-mailer transport registered in
#   AppServiceProvider — mail is sent over HTTPS (port 443).
#   BREVO_API_KEY = a Brevo REST API key (SMTP & API → API Keys tab — the
#     "xkeysib-…" key, NOT the SMTP key from the SMTP tab).
#   MAIL_FROM_ADDRESS must be a Brevo-verified sender
#     (SMTP & API → Senders — single-sender verification works without a domain;
#      with a real domain, authenticate it via Brevo's SPF/DKIM/DMARC DNS records).
MAIL_MAILER=brevo
BREVO_API_KEY=
# BREVO_DOMAIN — only needed if Brevo assigned you a regional API endpoint.
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP alternative (works on hosts that allow outbound SMTP):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-brevo-smtp-login
# MAIL_PASSWORD=your-brevo-smtp-key

# Dev alternative — Mailtrap (emails land in a fake inbox, never delivered):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<mailtrap-inbox-username>
# MAIL_PASSWORD=<mailtrap-inbox-password>

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_PUBLIC_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_ENDPOINT=
AWS_PUBLIC_URL=
AWS_PRIVATE_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional object-key prefixes inside each bucket (only used when the driver is s3).
# Leave empty to store keys at the bucket root, e.g. "payment-proofs/proof_....png".
PRIVATE_STORAGE_ROOT=
PUBLIC_STORAGE_ROOT=

VITE_APP_NAME="${APP_NAME}"

# AI Chatbot Configuration (Optional - enables AI-powered responses)
# Get your API key from: https://ai.google.dev (Google AI Studio)
CHATBOT_AI_ENABLED=false
CHATBOT_AI_API_KEY=
# Gemini models: gemini-3.6-flash (fast/cheap, free tier), gemini-3.6-pro (powerful)
CHATBOT_AI_MODEL=gemini-3.6-flash
# Google Gemini API endpoint
CHATBOT_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Hybrid Mode: faq_first | ai_first | smart
CHATBOT_HYBRID_MODE=faq_first

# Telegram Bot Configuration
# Get bot token from @BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Webhook URL - must be publicly accessible HTTPS URL
# Local testing: Use ngrok to expose your local server
# Example: https://your-ngrok-url.ngrok.io/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Webhook Secret Token (optional but recommended for security)
# Generate a random string: php -r "echo bin2hex(random_bytes(32));"
# This verifies webhook requests are from Telegram
TELEGRAM_WEBHOOK_SECRET=

# Admin Chat ID for admin notifications (optional)
# Get your chat ID by messaging the bot and checking webhook logs
TELEGRAM_ADMIN_CHAT_ID=

# For local development, override APP_ENV, APP_DEBUG, APP_URL, FRONTEND_URL,
# DB_* values, and CORS/Sanctum domains in your untracked .env file.
